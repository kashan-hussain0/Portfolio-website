@model PortfolioWebsite.Models.ViewModels.HomeViewModel
@{
    ViewData["Title"] = "Home";
    var profile = Model.Profile ?? new PortfolioWebsite.Models.Entities.Profile();
}

<!-- Hero Section -->
<section id="hero" class="hero-section">
    <div class="hero-bg">
        <div class="gradient-orb gradient-orb-1"></div>
        <div class="gradient-orb gradient-orb-2"></div>
        <div class="gradient-orb gradient-orb-3"></div>
    </div>
    <div class="container">
        <div class="hero-content">
            <div class="hero-image-wrapper">
                <div class="hero-image-glow"></div>
                <img src="@(string.IsNullOrEmpty(profile.ProfileImageUrl) ? "https://via.placeholder.com/300x300/6366f1/ffffff?text=Profile" : profile.ProfileImageUrl)" alt="@profile.FullName" class="hero-image" />
            </div>
            <div class="hero-text">
                <span class="hero-greeting animate-fade-in">Hello, I'm</span>
                <h1 class="hero-name animate-fade-in-delay-1">
                    <span class="text-gradient">@profile.FullName</span>
                </h1>
                <h2 class="hero-title animate-fade-in-delay-2">@profile.Title</h2>
                <p class="hero-tagline animate-fade-in-delay-3">@profile.Tagline</p>
                <div class="hero-cta animate-fade-in-delay-4">
                    <a href="#projects" class="btn btn-primary">
                        <span>View My Work</span>
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                    </a>
                    <a href="#contact" class="btn btn-outline">
                        <span>Get In Touch</span>
                    </a>
                </div>
                <div class="hero-social animate-fade-in-delay-5">
                    @if (!string.IsNullOrEmpty(profile.GitHubUrl))
                    {
                        <a href="@profile.GitHubUrl" target="_blank" rel="noopener" class="social-link" title="GitHub">
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
                        </a>
                    }
                    @if (!string.IsNullOrEmpty(profile.LinkedInUrl))
                    {
                        <a href="@profile.LinkedInUrl" target="_blank" rel="noopener" class="social-link" title="LinkedIn">
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
                        </a>
                    }
                    @if (!string.IsNullOrEmpty(profile.TwitterUrl))
                    {
                        <a href="@profile.TwitterUrl" target="_blank" rel="noopener" class="social-link" title="Twitter">
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
                        </a>
                    }
                    @if (!string.IsNullOrEmpty(profile.InstagramUrl))
                    {
                        <a href="@profile.InstagramUrl" target="_blank" rel="noopener" class="social-link" title="Instagram">
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
                        </a>
                    }
                </div>
            </div>
        </div>
        <div class="scroll-indicator">
            <span>Scroll Down</span>
            <div class="scroll-arrow"></div>
        </div>
    </div>
</section>

<!-- About Section -->
<section id="about" class="section about-section">
    <div class="container">
        <div class="section-header">
            <span class="section-tag">About Me</span>
            <h2 class="section-title">Who I Am</h2>
        </div>
        <div class="about-content">
            <div class="about-text">
                <p class="about-bio">@profile.Bio</p>
                <div class="about-details">
                    <div class="about-detail-item">
                        <span class="detail-label">Name</span>
                        <span class="detail-value">@profile.FullName</span>
                    </div>
                    <div class="about-detail-item">
                        <span class="detail-label">Email</span>
                        <span class="detail-value">@profile.Email</span>
                    </div>
                    <div class="about-detail-item">
                        <span class="detail-label">Location</span>
                        <span class="detail-value">@profile.Location</span>
                    </div>
                    <div class="about-detail-item">
                        <span class="detail-label">Availability</span>
                        <span class="detail-value">Open to Work</span>
                    </div>
                </div>
                @if (!string.IsNullOrEmpty(profile.ResumeUrl))
                {
                    <a href="@profile.ResumeUrl" target="_blank" class="btn btn-primary mt-4">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M7 10l5 5 5-5M12 15V3"/></svg>
                        <span>Download Resume</span>
                    </a>
                }
            </div>
        </div>
    </div>
</section>

<!-- Skills Section -->
<section id="skills" class="section skills-section">
    <div class="container">
        <div class="section-header">
            <span class="section-tag">Skills</span>
            <h2 class="section-title">My Expertise</h2>
        </div>
        <div class="skills-grid">
            @foreach (var category in Model.SkillCategories)
            {
                var categorySkills = Model.Skills.Where(s => (s.Category ?? "Other") == category).ToList();
                <div class="skill-category glass-card">
                    <h3 class="skill-category-title">@category</h3>
                    <div class="skills-list">
                        @foreach (var skill in categorySkills)
                        {
                            <div class="skill-item">
                                <div class="skill-info">
                                    <span class="skill-name">@skill.Name</span>
                                    <span class="skill-level">@skill.ProficiencyLevel%</span>
                                </div>
                                <div class="skill-bar">
                                    <div class="skill-progress" style="width: @skill.ProficiencyLevel%"></div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</section>

<!-- Projects Section -->
<section id="projects" class="section projects-section">
    <div class="container">
        <div class="section-header">
            <span class="section-tag">Portfolio</span>
            <h2 class="section-title">Featured Projects</h2>
        </div>
        <div class="project-filters">
            <button class="filter-btn active" data-filter="all">All</button>
            @foreach (var cat in Model.ProjectCategories)
            {
                <button class="filter-btn" data-filter="@cat.ToLower()">@cat</button>
            }
        </div>
        <div class="projects-grid">
            @foreach (var project in Model.Projects)
            {
                <div class="project-card glass-card" data-category="@(project.Category?.ToLower() ?? "other")">
                    <div class="project-image-wrapper">
                        <img src="@(string.IsNullOrEmpty(project.ImageUrl) ? "https://via.placeholder.com/400x250/1e1e2e/6366f1?text=Project" : project.ImageUrl)" alt="@project.Title" class="project-image" />
                        <div class="project-overlay">
                            <div class="project-links">
                                @if (!string.IsNullOrEmpty(project.LiveDemoUrl))
                                {
                                    <a href="@project.LiveDemoUrl" target="_blank" rel="noopener" class="project-link" title="Live Demo">
                                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6M15 3h6v6M10 14L21 3"/></svg>
                                    </a>
                                }
                                @if (!string.IsNullOrEmpty(project.GitHubUrl))
                                {
                                    <a href="@project.GitHubUrl" target="_blank" rel="noopener" class="project-link" title="GitHub">
                                        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
                                    </a>
                                }
                            </div>
                        </div>
                    </div>
                    <div class="project-content">
                        <span class="project-category">@project.Category</span>
                        <h3 class="project-title">@project.Title</h3>
                        <p class="project-description">@project.ShortDescription</p>
                        @if (!string.IsNullOrEmpty(project.Technologies))
                        {
                            <div class="project-tech">
                                @foreach (var tech in project.Technologies.Split(',').Take(4))
                                {
                                    <span class="tech-tag">@tech.Trim()</span>
                                }
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</section>

<!-- Experience Section -->
<section id="experience" class="section experience-section">
    <div class="container">
        <div class="section-header">
            <span class="section-tag">Career</span>
            <h2 class="section-title">Work Experience</h2>
        </div>
        <div class="timeline">
            @foreach (var exp in Model.Experiences)
            {
                <div class="timeline-item">
                    <div class="timeline-marker"></div>
                    <div class="timeline-content glass-card">
                        <div class="timeline-date">
                            <span>@exp.StartDate.ToString("MMM yyyy")</span>
                            @if (exp.IsCurrent)
                            {
                                <span>Present</span>
                            }
                            else if (exp.EndDate.HasValue)
                            {
                                <span>@exp.EndDate.Value.ToString("MMM yyyy")</span>
                            }
                        </div>
                        <h3 class="timeline-title">@exp.Title</h3>
                        <h4 class="timeline-company">@exp.Company</h4>
                        <p class="timeline-description">@exp.Description</p>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

<!-- Certifications Section -->
<section id="certifications" class="section certifications-section">
    <div class="container">
        <div class="section-header">
            <span class="section-tag">Certifications</span>
            <h2 class="section-title">My Certifications</h2>
        </div>
        <div class="certifications-grid">
            @foreach (var cert in Model.Certifications)
            {
                <div class="certification-card glass-card">
                    <div class="certification-icon">
                        <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="8" r="6"/><path d="M15.477 12.89 17 22l-5-3-5 3 1.523-9.11"/></svg>
                    </div>
                    <div class="certification-content">
                        <h3 class="certification-title">@cert.Title</h3>
                        <p class="certification-issuer">@cert.Issuer</p>
                        <div class="certification-details">
                            <span class="certification-date">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                                @(cert.IssueDate?.ToString("MMM yyyy") ?? "N/A")
                            </span>
                            @if (!cert.IsExpired)
                            {
                                <span class="badge badge-success">Active</span>
                            }
                            else
                            {
                                <span class="badge badge-danger">Expired</span>
                            }
                        </div>
                        @if (!string.IsNullOrEmpty(cert.CredentialUrl))
                        {
                            <a href="@cert.CredentialUrl" target="_blank" rel="noopener" class="certification-link">
                                <span>View Credential</span>
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6M15 3h6v6M10 14L21 3"/></svg>
                            </a>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</section>

<!-- Contact Section -->
<section id="contact" class="section contact-section">
    <div class="container">
        <div class="section-header">
            <span class="section-tag">Contact</span>
            <h2 class="section-title">Get In Touch</h2>
        </div>
        <div class="contact-content">
            <div class="contact-info">
                <h3>Let's work together</h3>
                <p>I'm currently available for freelance work and open to new opportunities. If you have a project in mind, I'd love to hear about it.</p>
                <div class="contact-details">
                    <div class="contact-detail-item">
                        <div class="contact-icon">
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
                        </div>
                        <div>
                            <span class="contact-label">Email</span>
                            <span class="contact-value">@profile.Email</span>
                        </div>
                    </div>
                    <div class="contact-detail-item">
                        <div class="contact-icon">
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
                        </div>
                        <div>
                            <span class="contact-label">Phone</span>
                            <span class="contact-value">@profile.Phone</span>
                        </div>
                    </div>
                    <div class="contact-detail-item">
                        <div class="contact-icon">
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                        </div>
                        <div>
                            <span class="contact-label">Location</span>
                            <span class="contact-value">@profile.Location</span>
                        </div>
                    </div>
                </div>
            </div>
            <div class="contact-form-wrapper">
                @if (Context.Request.Query.ContainsKey("success"))
                {
                    <div class="alert alert-success">@Context.Request.Query["success"]</div>
                }
                @if (Context.Request.Query.ContainsKey("error"))
                {
                    <div class="alert alert-error">@Context.Request.Query["error"]</div>
                }
                <form asp-action="Contact" method="post" class="contact-form">
                    <div class="form-group">
                        <label for="Name">Name</label>
                        <input type="text" id="Name" name="Name" class="form-control" placeholder="Your name" required />
                    </div>
                    <div class="form-group">
                        <label for="Email">Email</label>
                        <input type="email" id="Email" name="Email" class="form-control" placeholder="your@email.com" required />
                    </div>
                    <div class="form-group">
                        <label for="Subject">Subject</label>
                        <input type="text" id="Subject" name="Subject" class="form-control" placeholder="Project inquiry" />
                    </div>
                    <div class="form-group">
                        <label for="Message">Message</label>
                        <textarea id="Message" name="Message" class="form-control" rows="5" placeholder="Tell me about your project..." required></textarea>
                    </div>
                    <button type="submit" class="btn btn-primary btn-full">
                        <span>Send Message</span>
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
                    </button>
                </form>
            </div>
        </div>
    </div>
</section>
