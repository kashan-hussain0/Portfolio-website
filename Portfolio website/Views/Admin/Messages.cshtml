@model List<PortfolioWebsite.Models.Entities.ContactMessage>
@{
    ViewData["Title"] = "Contact Messages";
    Layout = "_AdminLayout";
}

<div class="admin-table-wrapper">
    <table class="admin-table">
        <thead>
            <tr>
                <th>Name</th>
                <th>Email</th>
                <th>Subject</th>
                <th>Date</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var message in Model)
            {
                <tr>
                    <td>@message.Name</td>
                    <td>@message.Email</td>
                    <td>@(string.IsNullOrEmpty(message.Subject) ? "-" : message.Subject)</td>
                    <td>@message.CreatedAt.ToString("MMM dd, yyyy")</td>
                    <td>
                        @if (message.IsRead)
                        {
                            <span class="badge badge-success">Read</span>
                        }
                        else
                        {
                            <span class="badge badge-warning">Unread</span>
                        }
                    </td>
                    <td>
                        <div class="admin-table-actions">
                            <a href="/Admin/Messages/Details/@message.Id" class="admin-table-btn admin-table-btn-edit">View</a>
                            <form asp-action="DeleteMessage" asp-route-id="@message.Id" method="post" style="display: inline;" onsubmit="return confirm('Are you sure you want to delete this message?');">
                                <button type="submit" class="admin-table-btn admin-table-btn-delete">Delete</button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
