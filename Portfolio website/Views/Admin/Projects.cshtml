@model List<PortfolioWebsite.Models.Entities.Project>
@{
    ViewData["Title"] = "Manage Projects";
    Layout = "_AdminLayout";
}

<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px;">
    <h2>All Projects</h2>
    <a href="/Admin/Projects/Create" class="admin-btn admin-btn-primary">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
        <span>Add New Project</span>
    </a>
</div>

<div class="admin-table-wrapper">
    <table class="admin-table">
        <thead>
            <tr>
                <th>Title</th>
                <th>Category</th>
                <th>Featured</th>
                <th>Created</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var project in Model)
            {
                <tr>
                    <td>@project.Title</td>
                    <td>@project.Category</td>
                    <td>
                        @if (project.IsFeatured)
                        {
                            <span class="badge badge-success">Yes</span>
                        }
                        else
                        {
                            <span class="badge badge-warning">No</span>
                        }
                    </td>
                    <td>@project.CreatedAt.ToString("MMM dd, yyyy")</td>
                    <td>
                        <div class="admin-table-actions">
                            <a href="/Admin/Projects/Edit/@project.Id" class="admin-table-btn admin-table-btn-edit">Edit</a>
                            <form asp-action="DeleteProject" asp-route-id="@project.Id" method="post" style="display: inline;" onsubmit="return confirm('Are you sure you want to delete this project?');">
                                <button type="submit" class="admin-table-btn admin-table-btn-delete">Delete</button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
