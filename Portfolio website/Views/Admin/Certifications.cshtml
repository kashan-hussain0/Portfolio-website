@model List<PortfolioWebsite.Models.Entities.Certification>
@{
    ViewData["Title"] = "Manage Certifications";
    Layout = "_AdminLayout";
}

<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px;">
    <h2>All Certifications</h2>
    <a href="/Admin/Certifications/Create" class="admin-btn admin-btn-primary">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
        <span>Add New Certification</span>
    </a>
</div>

<div class="admin-table-wrapper">
    <table class="admin-table">
        <thead>
            <tr>
                <th>Title</th>
                <th>Issuer</th>
                <th>Issue Date</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var cert in Model)
            {
                <tr>
                    <td>@cert.Title</td>
                    <td>@cert.Issuer</td>
                    <td>@(cert.IssueDate?.ToString("MMM yyyy") ?? "N/A")</td>
                    <td>
                        @if (cert.IsExpired)
                        {
                            <span class="badge badge-danger">Expired</span>
                        }
                        else
                        {
                            <span class="badge badge-success">Active</span>
                        }
                    </td>
                    <td>
                        <div class="admin-table-actions">
                            <a href="/Admin/Certifications/Edit/@cert.Id" class="admin-table-btn admin-table-btn-edit">Edit</a>
                            <form asp-action="DeleteCertification" asp-route-id="@cert.Id" method="post" style="display: inline;" onsubmit="return confirm('Are you sure you want to delete this certification?');">
                                <button type="submit" class="admin-table-btn admin-table-btn-delete">Delete</button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
