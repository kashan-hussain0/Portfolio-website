@model PortfolioWebsite.Models.Entities.Project
@{
    ViewData["Title"] = "Create Project";
    Layout = "_AdminLayout";
}

<div class="admin-form-wrapper">
    <form action="/Admin/Projects/Create" method="post" enctype="multipart/form-data" class="admin-form">
        @Html.AntiForgeryToken()

        <div class="admin-form-group">
            <label for="Title">Title *</label>
            <input type="text" id="Title" name="Title" class="admin-form-control" required />
        </div>

        <div class="admin-form-group">
            <label for="ShortDescription">Short Description</label>
            <input type="text" id="ShortDescription" name="ShortDescription" class="admin-form-control" />
        </div>

        <div class="admin-form-group">
            <label for="Description">Full Description</label>
            <textarea id="Description" name="Description" class="admin-form-control" rows="4"></textarea>
        </div>

        <div class="admin-form-group">
            <label>Project Image</label>
            <div class="image-upload-section">
                <div class="upload-options">
                    <div class="upload-option">
                        <label for="projectImageInput" class="upload-label">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M17 8l-5-5-5 5M12 3v12"/></svg>
                            Upload Image
                        </label>
                        <input type="file" id="projectImageInput" name="projectImage" accept="image/*" class="file-input" />
                    </div>
                    <div class="upload-divider">OR</div>
                    <div class="url-input-wrapper">
                        <label for="ImageUrl">Image URL</label>
                        <input type="text" id="ImageUrl" name="ImageUrl" class="admin-form-control" placeholder="https://example.com/image.jpg" />
                    </div>
                </div>
            </div>
        </div>

        <div class="admin-form-row">
            <div class="admin-form-group">
                <label for="Category">Category</label>
                <input type="text" id="Category" name="Category" class="admin-form-control" />
            </div>
            <div class="admin-form-group">
                <label for="Technologies">Technologies</label>
                <input type="text" id="Technologies" name="Technologies" class="admin-form-control" placeholder="C#, ASP.NET, SQL" />
            </div>
        </div>

        <div class="admin-form-row">
            <div class="admin-form-group">
                <label for="LiveDemoUrl">Live Demo URL</label>
                <input type="text" id="LiveDemoUrl" name="LiveDemoUrl" class="admin-form-control" />
            </div>
            <div class="admin-form-group">
                <label for="GitHubUrl">GitHub URL</label>
                <input type="text" id="GitHubUrl" name="GitHubUrl" class="admin-form-control" />
            </div>
        </div>

        <div class="admin-form-row">
            <div class="admin-form-group">
                <label for="DisplayOrder">Display Order</label>
                <input type="number" id="DisplayOrder" name="DisplayOrder" value="0" class="admin-form-control" />
            </div>
            <div class="admin-form-group">
                <label>Featured</label>
                <div style="display: flex; align-items: center; gap: 8px; padding: 12px 0;">
                    <input type="checkbox" id="IsFeatured" name="IsFeatured" value="true" style="width: 20px; height: 20px;" />
                    <span>Show as featured</span>
                </div>
            </div>
        </div>

        <div class="admin-form-actions">
            <button type="submit" class="admin-btn admin-btn-primary">
                <span>Create Project</span>
            </button>
            <a href="/Admin/Projects" class="admin-btn admin-btn-secondary">Cancel</a>
        </div>
    </form>
</div>
