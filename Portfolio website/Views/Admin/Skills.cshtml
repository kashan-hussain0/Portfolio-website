@model List<PortfolioWebsite.Models.Entities.Skill>
@{
    ViewData["Title"] = "Manage Skills";
    Layout = "_AdminLayout";
}

<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px;">
    <h2>All Skills</h2>
    <a href="/Admin/Skills/Create" class="admin-btn admin-btn-primary">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
        <span>Add New Skill</span>
    </a>
</div>

<div class="admin-table-wrapper">
    <table class="admin-table">
        <thead>
            <tr>
                <th>Name</th>
                <th>Category</th>
                <th>Proficiency</th>
                <th>Order</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var skill in Model)
            {
                <tr>
                    <td>@skill.Name</td>
                    <td>@skill.Category</td>
                    <td>
                        <div style="display: flex; align-items: center; gap: 12px;">
                            <div style="width: 100px; height: 8px; background: var(--bg-tertiary); border-radius: 10px; overflow: hidden;">
                                <div style="width: @skill.ProficiencyLevel%; height: 100%; background: var(--accent-gradient); border-radius: 10px;"></div>
                            </div>
                            <span>@skill.ProficiencyLevel%</span>
                        </div>
                    </td>
                    <td>@skill.DisplayOrder</td>
                    <td>
                        <div class="admin-table-actions">
                            <a href="/Admin/Skills/Edit/@skill.Id" class="admin-table-btn admin-table-btn-edit">Edit</a>
                            <form asp-action="DeleteSkill" asp-route-id="@skill.Id" method="post" style="display: inline;" onsubmit="return confirm('Are you sure you want to delete this skill?');">
                                <button type="submit" class="admin-table-btn admin-table-btn-delete">Delete</button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
