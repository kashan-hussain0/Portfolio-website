@model PortfolioWebsite.Models.ViewModels.AdminDashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
    Layout = "_AdminLayout";
}

<div class="admin-cards">
    <div class="admin-card">
        <div class="admin-card-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/></svg>
        </div>
        <div class="admin-card-value">@Model.TotalProjects</div>
        <div class="admin-card-label">Total Projects</div>
    </div>
    <div class="admin-card">
        <div class="admin-card-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
        </div>
        <div class="admin-card-value">@Model.TotalSkills</div>
        <div class="admin-card-label">Total Skills</div>
    </div>
    <div class="admin-card">
        <div class="admin-card-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
        </div>
        <div class="admin-card-value">@Model.TotalMessages</div>
        <div class="admin-card-label">Total Messages</div>
    </div>
    <div class="admin-card">
        <div class="admin-card-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
        </div>
        <div class="admin-card-value">@Model.UnreadMessages</div>
        <div class="admin-card-label">Unread Messages</div>
    </div>
</div>

<div class="admin-table-wrapper">
    <table class="admin-table">
        <thead>
            <tr>
                <th>Name</th>
                <th>Email</th>
                <th>Subject</th>
                <th>Date</th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var message in Model.RecentMessages)
            {
                <tr>
                    <td>@message.Name</td>
                    <td>@message.Email</td>
                    <td>@(string.IsNullOrEmpty(message.Subject) ? "-" : message.Subject)</td>
                    <td>@message.CreatedAt.ToString("MMM dd, yyyy")</td>
                    <td>
                        @if (message.IsRead)
                        {
                            <span class="badge badge-success">Read</span>
                        }
                        else
                        {
                            <span class="badge badge-warning">Unread</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
