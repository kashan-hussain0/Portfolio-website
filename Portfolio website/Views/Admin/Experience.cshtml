@model List<PortfolioWebsite.Models.Entities.Experience>
@{
    ViewData["Title"] = "Manage Experience";
    Layout = "_AdminLayout";
}

<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px;">
    <h2>All Experience</h2>
    <a href="/Admin/Experience/Create" class="admin-btn admin-btn-primary">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
        <span>Add New Experience</span>
    </a>
</div>

<div class="admin-table-wrapper">
    <table class="admin-table">
        <thead>
            <tr>
                <th>Title</th>
                <th>Company</th>
                <th>Period</th>
                <th>Current</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var exp in Model)
            {
                <tr>
                    <td>@exp.Title</td>
                    <td>@exp.Company</td>
                    <td>
                        @exp.StartDate.ToString("MMM yyyy") -
                        @(exp.IsCurrent ? "Present" : exp.EndDate?.ToString("MMM yyyy") ?? "N/A")
                    </td>
                    <td>
                        @if (exp.IsCurrent)
                        {
                            <span class="badge badge-success">Current</span>
                        }
                        else
                        {
                            <span class="badge badge-warning">Past</span>
                        }
                    </td>
                    <td>
                        <div class="admin-table-actions">
                            <a href="/Admin/Experience/Edit/@exp.Id" class="admin-table-btn admin-table-btn-edit">Edit</a>
                            <form asp-action="DeleteExperience" asp-route-id="@exp.Id" method="post" style="display: inline;" onsubmit="return confirm('Are you sure you want to delete this experience?');">
                                <button type="submit" class="admin-table-btn admin-table-btn-delete">Delete</button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
