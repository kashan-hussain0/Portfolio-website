<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Admin Panel</title>
    <link rel="icon" type="image/x-icon" href="~/favicon.ico" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="admin-layout">
        <aside class="admin-sidebar" id="adminSidebar">
            <div class="admin-sidebar-header">
                <span class="admin-sidebar-title">Admin Panel</span>
            </div>
            <nav class="admin-nav">
                <a href="/Admin" class="admin-nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Dashboard" ? "active" : "")">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
                    <span>Dashboard</span>
                </a>
                <a href="/Admin/Profile" class="admin-nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Profile" ? "active" : "")">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                    <span>Profile</span>
                </a>
                <a href="/Admin/Projects" class="admin-nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Projects" || ViewContext.RouteData.Values["action"]?.ToString() == "CreateProject" || ViewContext.RouteData.Values["action"]?.ToString() == "EditProject" ? "active" : "")">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/></svg>
                    <span>Projects</span>
                </a>
                <a href="/Admin/Skills" class="admin-nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Skills" || ViewContext.RouteData.Values["action"]?.ToString() == "CreateSkill" || ViewContext.RouteData.Values["action"]?.ToString() == "EditSkill" ? "active" : "")">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                    <span>Skills</span>
                </a>
                <a href="/Admin/Experience" class="admin-nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Experience" || ViewContext.RouteData.Values["action"]?.ToString() == "CreateExperience" || ViewContext.RouteData.Values["action"]?.ToString() == "EditExperience" ? "active" : "")">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="7" width="20" height="14" rx="2" ry="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>
                    <span>Experience</span>
                </a>
                <a href="/Admin/Certifications" class="admin-nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Certifications" || ViewContext.RouteData.Values["action"]?.ToString() == "CreateCertification" || ViewContext.RouteData.Values["action"]?.ToString() == "EditCertification" ? "active" : "")">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="8" r="6"/><path d="M15.477 12.89 17 22l-5-3-5 3 1.523-9.11"/></svg>
                    <span>Certifications</span>
                </a>
                <a href="/Admin/Messages" class="admin-nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Messages" || ViewContext.RouteData.Values["action"]?.ToString() == "MessageDetails" ? "active" : "")">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
                    <span>Messages</span>
                </a>
            </nav>
        </aside>

        <main class="admin-main">
            <div class="admin-header">
                <h1 class="admin-page-title">@ViewData["Title"]</h1>
                <div class="admin-user-info">
                    <span class="admin-username">@User.Identity?.Name</span>
                    <form asp-action="Logout" asp-controller="Admin" method="post" style="display: inline;">
                        <button type="submit" class="admin-logout-btn">Logout</button>
                    </form>
                </div>
            </div>

            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success">@TempData["Success"]</div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-error">@TempData["Error"]</div>
            }

            @RenderBody()
        </main>
    </div>

    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
